# Copier ce fichier en .env et remplacer les valeurs avant le premier lancement.

# === Authentification API ===
API_KEY=changeme-generate-a-strong-random-key
JWT_SECRET_KEY=changeme-generate-a-strong-random-key
JWT_EXPIRE_MINUTES=1440

# === OSRM ===
OSRM_URL=http://localhost:5000

# === PostgreSQL ===
POSTGRES_USER=routezone
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=routezone
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://routezone:changeme-strong-password@db:5432/routezone
